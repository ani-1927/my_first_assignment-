USE sakila;
-- 1. Customers who have made more than 5 payments
SELECT *
FROM customer
WHERE customer_id IN (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    HAVING COUNT(*) > 5
);
-- 2. Actors who have acted in more than 10 films
SELECT first_name, last_name
FROM actor
WHERE actor_id IN (
    SELECT actor_id
    FROM film_actor
    GROUP BY actor_id
    HAVING COUNT(film_id) > 10
);
-- 3. Customers who never made a payment
SELECT first_name, last_name
FROM customer
WHERE customer_id NOT IN (
    SELECT DISTINCT customer_id
    FROM payment
);
-- 4. Films whose rental rate is above the average rental rate
SELECT title, rental_rate
FROM film
WHERE rental_rate > (
    SELECT AVG(rental_rate)
    FROM film
);
-- 5. Films that were never rented
SELECT title
FROM film
WHERE film_id NOT IN (
    SELECT film_id
    FROM inventory
    WHERE inventory_id IN (
        SELECT inventory_id
        FROM rental
    )
);
-- 6. Customers who rented in the same month (and year) as customer 5
SELECT *
FROM customer
WHERE customer_id IN (
    SELECT customer_id
    FROM rental
    WHERE (YEAR(rental_date), MONTH(rental_date)) IN (
        SELECT DISTINCT YEAR(rental_date), MONTH(rental_date)
        FROM rental
        WHERE customer_id = 5
    )
)
AND customer_id <> 5;
-- 7. Staff who handled a payment greater than the average payment
SELECT *
FROM staff
WHERE staff_id IN (
    SELECT staff_id
    FROM payment
    WHERE amount > (
        SELECT AVG(amount)
        FROM payment
    )
);
-- 8. Films whose rental duration is above the average
SELECT title, rental_duration
FROM film
WHERE rental_duration > (
    SELECT AVG(rental_duration)
    FROM film
);
-- 9. Customers with the same address as customer 1
SELECT *
FROM customer
WHERE address_id = (
    SELECT address_id
    FROM customer
    WHERE customer_id = 1
)
AND customer_id <> 1;
-- 10. Payments greater than the average payment
SELECT *
FROM payment
WHERE amount > (
    SELECT AVG(amount)
    FROM payment
);
Using CTE
USE sakila;
-- 1. Customers who have made more than 5 payments
WITH payment_counts AS (
    SELECT customer_id, COUNT(*) AS total_payments
    FROM payment
    GROUP BY customer_id
)
SELECT c.*, pc.total_payments
FROM customer c
JOIN payment_counts pc ON c.customer_id = pc.customer_id
WHERE pc.total_payments > 5;
-- 2. Actors who have acted in more than 10 films
WITH actor_film_counts AS (
    SELECT actor_id, COUNT(film_id) AS film_count
    FROM film_actor
    GROUP BY actor_id
)
SELECT a.first_name, a.last_name, afc.film_count
FROM actor a
JOIN actor_film_counts afc ON a.actor_id = afc.actor_id
WHERE afc.film_count > 10;
-- 3. Customers who never made a payment
WITH paying_customers AS (
    SELECT DISTINCT customer_id
    FROM payment
)
SELECT c.first_name, c.last_name
FROM customer c
LEFT JOIN paying_customers pc ON c.customer_id = pc.customer_id
WHERE pc.customer_id IS NULL;
-- 4. Films whose rental rate is above the average rental rate
WITH avg_rate AS (
    SELECT AVG(rental_rate) AS avg_rental_rate
    FROM film
)
SELECT f.title, f.rental_rate
FROM film f
CROSS JOIN avg_rate ar
WHERE f.rental_rate > ar.avg_rental_rate;
-- 5. Films that were never rented
WITH rented_films AS (
    SELECT DISTINCT i.film_id
    FROM inventory i
    JOIN rental r ON i.inventory_id = r.inventory_id
)
SELECT f.title
FROM film f
LEFT JOIN rented_films rf ON f.film_id = rf.film_id
WHERE rf.film_id IS NULL;
-- 6. Customers who rented in the same month (and year) as customer 5
WITH customer5_months AS (
    SELECT DISTINCT YEAR(rental_date) AS yr, MONTH(rental_date) AS mon
    FROM rental
    WHERE customer_id = 5
),
matching_customers AS (
    SELECT DISTINCT r.customer_id
    FROM rental r
    JOIN customer5_months cm
      ON YEAR(r.rental_date) = cm.yr
     AND MONTH(r.rental_date) = cm.mon
    WHERE r.customer_id <> 5
)
SELECT c.*
FROM customer c
JOIN matching_customers mc ON c.customer_id = mc.customer_id;
-- 7. Staff who handled a payment greater than the average payment
WITH avg_payment AS (
    SELECT AVG(amount) AS avg_amount
    FROM payment
),
qualifying_staff AS (
    SELECT DISTINCT p.staff_id
    FROM payment p
    CROSS JOIN avg_payment ap
    WHERE p.amount > ap.avg_amount
)
SELECT s.*
FROM staff s
JOIN qualifying_staff qs ON s.staff_id = qs.staff_id;
-- 8. Films whose rental duration is above the average
WITH avg_duration AS (
    SELECT AVG(rental_duration) AS avg_rental_duration
    FROM film
)
SELECT f.title, f.rental_duration
FROM film f
CROSS JOIN avg_duration ad
WHERE f.rental_duration > ad.avg_rental_duration;
-- 9. Customers with the same address as customer 1
WITH customer1_address AS (
    SELECT address_id
    FROM customer
    WHERE customer_id = 1
)
SELECT c.*
FROM customer c
JOIN customer1_address ca ON c.address_id = ca.address_id
WHERE c.customer_id <> 1;
-- 10. Payments greater than the average payment
WITH avg_payment AS (
    SELECT AVG(amount) AS avg_amount
    FROM payment
)
SELECT p.*
FROM payment p
CROSS JOIN avg_payment ap
WHERE p.amount > ap.avg_amount;
Using recursive CTE
Q6
WITH RECURSIVE months AS (
    SELECT DATE_FORMAT(MIN(rental_date), '%Y-%m-01') AS month_start,
           DATE_FORMAT(MAX(rental_date), '%Y-%m-01') AS last_month
    FROM rental
    UNION ALL
    SELECT DATE_ADD(month_start, INTERVAL 1 MONTH), last_month
    FROM months
    WHERE month_start < last_month
)
SELECT DATE_FORMAT(m.month_start, '%Y-%m') AS rental_month,
       COUNT(r.rental_id) AS rentals
FROM months m
LEFT JOIN rental r
  ON r.rental_date >= m.month_start
 AND r.rental_date <  DATE_ADD(m.month_start, INTERVAL 1 MONTH)
GROUP BY m.month_start
ORDER BY m.month_start;
Temp Table
USE sakila;
-- 1. Customers who have made more than 5 payments
DROP TEMPORARY TABLE IF EXISTS tmp_payment_counts;
CREATE TEMPORARY TABLE tmp_payment_counts AS
SELECT customer_id, COUNT(*) AS total_payments
FROM payment
GROUP BY customer_id;
SELECT c.*, t.total_payments
FROM customer c
JOIN tmp_payment_counts t ON c.customer_id = t.customer_id
WHERE t.total_payments > 5;
-- 2. Actors who have acted in more than 10 films
DROP TEMPORARY TABLE IF EXISTS tmp_actor_film_counts;
CREATE TEMPORARY TABLE tmp_actor_film_counts AS
SELECT actor_id, COUNT(film_id) AS film_count
FROM film_actor
GROUP BY actor_id;
SELECT a.first_name, a.last_name, t.film_count
FROM actor a
JOIN tmp_actor_film_counts t ON a.actor_id = t.actor_id
WHERE t.film_count > 10;
-- 3. Customers who never made a payment
DROP TEMPORARY TABLE IF EXISTS tmp_paying_customers;
CREATE TEMPORARY TABLE tmp_paying_customers AS
SELECT DISTINCT customer_id
FROM payment;
SELECT c.first_name, c.last_name
FROM customer c
LEFT JOIN tmp_paying_customers t ON c.customer_id = t.customer_id
WHERE t.customer_id IS NULL;
-- 4. Films whose rental rate is above the average rental rate
DROP TEMPORARY TABLE IF EXISTS tmp_avg_rate;
CREATE TEMPORARY TABLE tmp_avg_rate AS
SELECT AVG(rental_rate) AS avg_rental_rate
FROM film;
SELECT f.title, f.rental_rate
FROM film f
CROSS JOIN tmp_avg_rate t
WHERE f.rental_rate > t.avg_rental_rate;
-- 5. Films that were never rented
DROP TEMPORARY TABLE IF EXISTS tmp_rented_films;
CREATE TEMPORARY TABLE tmp_rented_films AS
SELECT DISTINCT i.film_id
FROM inventory i
JOIN rental r ON i.inventory_id = r.inventory_id;
SELECT f.title
FROM film f
LEFT JOIN tmp_rented_films t ON f.film_id = t.film_id
WHERE t.film_id IS NULL;
-- 6. Customers who rented in the same month (and year) as customer 5
DROP TEMPORARY TABLE IF EXISTS tmp_customer5_months;
CREATE TEMPORARY TABLE tmp_customer5_months AS
SELECT DISTINCT YEAR(rental_date) AS yr, MONTH(rental_date) AS mon
FROM rental
WHERE customer_id = 5;
DROP TEMPORARY TABLE IF EXISTS tmp_matching_customers;
CREATE TEMPORARY TABLE tmp_matching_customers AS
SELECT DISTINCT r.customer_id
FROM rental r
JOIN tmp_customer5_months t
  ON YEAR(r.rental_date) = t.yr
 AND MONTH(r.rental_date) = t.mon
WHERE r.customer_id <> 5;
SELECT c.*
FROM customer c
JOIN tmp_matching_customers t ON c.customer_id = t.customer_id;
-- 7. Staff who handled a payment greater than the average payment
DROP TEMPORARY TABLE IF EXISTS tmp_avg_payment;
CREATE TEMPORARY TABLE tmp_avg_payment AS
SELECT AVG(amount) AS avg_amount
FROM payment;
SELECT s.*
FROM staff s
WHERE s.staff_id IN (
    SELECT DISTINCT p.staff_id
    FROM payment p
    CROSS JOIN tmp_avg_payment t
    WHERE p.amount > t.avg_amount
);
-- 8. Films whose rental duration is above the average
DROP TEMPORARY TABLE IF EXISTS tmp_avg_duration;
CREATE TEMPORARY TABLE tmp_avg_duration AS
SELECT AVG(rental_duration) AS avg_rental_duration
FROM film;
SELECT f.title, f.rental_duration
FROM film f
CROSS JOIN tmp_avg_duration t
WHERE f.rental_duration > t.avg_rental_duration;
-- 9. Customers with the same address as customer 1
DROP TEMPORARY TABLE IF EXISTS tmp_customer1_address;
CREATE TEMPORARY TABLE tmp_customer1_address AS
SELECT address_id
FROM customer
WHERE customer_id = 1;
SELECT c.*
FROM customer c
JOIN tmp_customer1_address t ON c.address_id = t.address_id
WHERE c.customer_id <> 1;
-- 10. Payments greater than the average payment
--     (reuses tmp_avg_payment from Q7 in the same session)
SELECT p.*
FROM payment p
CROSS JOIN tmp_avg_payment t
WHERE p.amount > t.avg_amount;
Views
USE sakila;
-- 1. Customers who have made more than 5 payments
CREATE OR REPLACE VIEW v_payment_counts AS
SELECT customer_id, COUNT(*) AS total_payments
FROM payment
GROUP BY customer_id;
SELECT c.*, v.total_payments
FROM customer c
JOIN v_payment_counts v ON c.customer_id = v.customer_id
WHERE v.total_payments > 5;
-- 2. Actors who have acted in more than 10 films
CREATE OR REPLACE VIEW v_actor_film_counts AS
SELECT actor_id, COUNT(film_id) AS film_count
FROM film_actor
GROUP BY actor_id;
SELECT a.first_name, a.last_name, v.film_count
FROM actor a
JOIN v_actor_film_counts v ON a.actor_id = v.actor_id
WHERE v.film_count > 10;
-- 3. Customers who never made a payment
CREATE OR REPLACE VIEW v_paying_customers AS
SELECT DISTINCT customer_id
FROM payment;
SELECT c.first_name, c.last_name
FROM customer c
LEFT JOIN v_paying_customers v ON c.customer_id = v.customer_id
WHERE v.customer_id IS NULL;
-- 4. Films whose rental rate is above the average rental rate
CREATE OR REPLACE VIEW v_avg_rate AS
SELECT AVG(rental_rate) AS avg_rental_rate
FROM film;
SELECT f.title, f.rental_rate
FROM film f
CROSS JOIN v_avg_rate v
WHERE f.rental_rate > v.avg_rental_rate;
-- 5. Films that were never rented
CREATE OR REPLACE VIEW v_rented_films AS
SELECT DISTINCT i.film_id
FROM inventory i
JOIN rental r ON i.inventory_id = r.inventory_id;
SELECT f.title
FROM film f
LEFT JOIN v_rented_films v ON f.film_id = v.film_id
WHERE v.film_id IS NULL;
-- 6. Customers who rented in the same month (and year) as customer 5
CREATE OR REPLACE VIEW v_rental_months AS
SELECT DISTINCT customer_id,
       YEAR(rental_date)  AS yr,
       MONTH(rental_date) AS mon
FROM rental;
SELECT c.*
FROM customer c
WHERE c.customer_id IN (
    SELECT o.customer_id
    FROM v_rental_months o
    JOIN v_rental_months c5
      ON o.yr = c5.yr AND o.mon = c5.mon
    WHERE c5.customer_id = 5
      AND o.customer_id <> 5
);
-- 7. Staff who handled a payment greater than the average payment
CREATE OR REPLACE VIEW v_avg_payment AS
SELECT AVG(amount) AS avg_amount
FROM payment;
SELECT s.*
FROM staff s
WHERE s.staff_id IN (
    SELECT DISTINCT p.staff_id
    FROM payment p
    CROSS JOIN v_avg_payment v
    WHERE p.amount > v.avg_amount
);
-- 8. Films whose rental duration is above the average
CREATE OR REPLACE VIEW v_avg_duration AS
SELECT AVG(rental_duration) AS avg_rental_duration
FROM film;
SELECT f.title, f.rental_duration
FROM film f
CROSS JOIN v_avg_duration v
WHERE f.rental_duration > v.avg_rental_duration;
-- 9. Customers with the same address as customer 1
--    (self-join on customer, no extra view needed)
SELECT c.*
FROM customer c
JOIN customer c1 ON c.address_id = c1.address_id
WHERE c1.customer_id = 1
  AND c.customer_id <> 1;
-- 10. Payments greater than the average payment
--     (reuses v_avg_payment from Q7)
SELECT p.*
FROM payment p
CROSS JOIN v_avg_payment v
WHERE p.amount > v.avg_amount;
